COMPANY_NAME="Vercel Inc."
SITE_NAME="Next.js Commerce"

# Base URL of the nopCommerce Headless Storefront API plugin, e.g.
# https://your-nopcommerce-host/api/storefront  (or http://localhost:5000/api/storefront for local dev)
NOPCOMMERCE_API_URL="http://localhost:5000/api/storefront"

# Shared secret used to authenticate cache-revalidation webhooks from nopCommerce.
# Must match the "Revalidation secret" configured in the plugin admin page.
NOPCOMMERCE_REVALIDATION_SECRET=""

# Optional: comma-separated extra image hostnames (e.g. a CDN/blob storage host)
# NOPCOMMERCE_IMAGE_HOSTNAMES=""
